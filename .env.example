# Copia este archivo como .env (no se sube a GitHub) y llena SOLO el proveedor que uses.
# En Vercel, pon las mismas variables en Settings > Environment Variables.

# Proveedor: gemini | groq | openrouter | kimi | custom
AI_PROVIDER=gemini

# Opcional: cambia el modelo por defecto del proveedor
# AI_MODEL=gemini-2.5-flash

# Opcional (solo Gemini): modelos de respaldo si el principal está saturado o sin cuota
# AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# --- Gemini (Google AI Studio, gratis) — recomendado: lee la foto del ejercicio y la pizarra
GEMINI_API_KEY=

# --- Groq (gratis, muy rápido)
# GROQ_API_KEY=

# --- OpenRouter (modelos ":free", incluye Gemma)
# OPENROUTER_API_KEY=

# --- Kimi / Moonshot (normalmente requiere saldo)
# MOONSHOT_API_KEY=

# --- custom: cualquier API compatible con OpenAI
# AI_BASE_URL=https://api.ejemplo.com/v1
# AI_API_KEY=
# AI_MODEL=nombre-del-modelo
